using System.Collections;
using UnityEngine;


public class CaseOpeningPanelUI : MonoBehaviour
{
    [SerializeField] private GameObject panel;
    [SerializeField] private bool hideOnStart = true;
    [SerializeField] private bool useCanvasGroup = true;
    [SerializeField] private CaseOpeningRouletteUI roulette;
    [SerializeField] private float autoHideDelay = 2f;

    private CanvasGroup _canvasGroup;
    private bool _subscribed;
    private Coroutine _subscribeRoutine;
    private Coroutine _autoHideRoutine;

    private void Awake()
    {
        var target = panel != null ? panel : gameObject;
        if (useCanvasGroup)
        {
            _canvasGroup = target.GetComponent<CanvasGroup>();
            if (_canvasGroup == null)
                _canvasGroup = target.AddComponent<CanvasGroup>();
        }

        if (hideOnStart)
            SetVisible(false);
    }

    private void OnEnable()
    {
        TrySubscribe();
    }

    private void OnDisable()
    {
        Unsubscribe();
    }

    private void TrySubscribe()
    {
        if (_subscribed) return;

        if (GameManager.Instance != null)
        {
            GameManager.Instance.OnCaseOpened.AddListener(OnCaseOpened);
            GameManager.Instance.OnCaseOpenedWithItem.AddListener(OnCaseOpenedWithItem);
            _subscribed = true;
            SubscribeRoulette();
            return;
        }

        if (_subscribeRoutine == null)
            _subscribeRoutine = StartCoroutine(WaitForGameManager());
    }

    private IEnumerator WaitForGameManager()
    {
        while (GameManager.Instance == null)
            yield return null;

        GameManager.Instance.OnCaseOpened.AddListener(OnCaseOpened);
        GameManager.Instance.OnCaseOpenedWithItem.AddListener(OnCaseOpenedWithItem);
        _subscribed = true;
        SubscribeRoulette();
        _subscribeRoutine = null;
    }

    private void Unsubscribe()
    {
        if (_subscribeRoutine != null)
        {
            StopCoroutine(_subscribeRoutine);
            _subscribeRoutine = null;
        }

        if (!_subscribed || GameManager.Instance == null)
            return;

        GameManager.Instance.OnCaseOpened.RemoveListener(OnCaseOpened);
        GameManager.Instance.OnCaseOpenedWithItem.RemoveListener(OnCaseOpenedWithItem);
        _subscribed = false;

        UnsubscribeRoulette();
    }

    private void OnCaseOpened(CaseData _)
    {
        SetVisible(true);
    }

    private void OnCaseOpenedWithItem(CaseData caseData, CaseItemData item)
    {
        if (roulette != null)
            roulette.SetRollData(caseData, item);
    }

    private void SubscribeRoulette()
    {
        if (roulette == null)
            return;

        roulette.OnRollFinished.RemoveListener(OnRollFinished);
        roulette.OnRollFinished.AddListener(OnRollFinished);
    }

    private void UnsubscribeRoulette()
    {
        if (roulette == null)
            return;

        roulette.OnRollFinished.RemoveListener(OnRollFinished);
    }

    private void OnRollFinished(CaseItemData _)
    {
        if (roulette != null && roulette.LastOpenInstant)
        {
            Hide();
            return;
        }

        if (autoHideDelay <= 0f)
        {
            Hide();
            return;
        }

        if (_autoHideRoutine != null)
            StopCoroutine(_autoHideRoutine);

        _autoHideRoutine = StartCoroutine(HideAfterDelay());
    }

    private IEnumerator HideAfterDelay()
    {
        yield return new WaitForSeconds(autoHideDelay);
        Hide();
        _autoHideRoutine = null;
    }

    public void Show()
    {
        SetVisible(true);
    }

    public void Hide()
    {
        SetVisible(false);
    }

    private void SetVisible(bool visible)
    {
        var target = panel != null ? panel : gameObject;

        if (visible)
            target.SetActive(true);

        if (useCanvasGroup)
        {
            var groups = target.GetComponentsInChildren<CanvasGroup>(true);
            if (groups.Length == 0)
            {
                _canvasGroup = target.GetComponent<CanvasGroup>();
                if (_canvasGroup == null)
                    _canvasGroup = target.AddComponent<CanvasGroup>();
                groups = new[] { _canvasGroup };
            }

            for (int i = 0; i < groups.Length; i++)
            {
                var group = groups[i];
                if (group == null) continue;
                group.alpha = visible ? 1f : 0f;
                group.interactable = visible;
                group.blocksRaycasts = visible;
            }
            return;
        }

        target.SetActive(visible);
    }
}
